# Copy this file to .env and fill in real values. Never commit .env.
# Section 11 — Tech Stack & Complete API Key List

DATABASE_URL="postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key"
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

# Cloudinary — product images (Section 10/11), invoice PDFs and chart PNGs land here in later phases
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="placeholder-cloud-name"
CLOUDINARY_API_KEY="placeholder-cloudinary-api-key"
CLOUDINARY_API_SECRET="placeholder-cloudinary-api-secret"

# Gmail — sending (Phase 3, Section 9)
GMAIL_USER="omegascales.official@gmail.com"
GMAIL_APP_PASSWORD="placeholder-app-password"

# Gmail — reading/inbox (Phase 3, Section 9.1)
GMAIL_CLIENT_ID="placeholder-client-id"
GMAIL_CLIENT_SECRET="placeholder-client-secret"
GMAIL_REFRESH_TOKEN="placeholder-refresh-token"

# OpenAI — AI Reply drafts + Scan Slip vision extraction (Phase 3, Section 5.4.K/9.1)
OPENAI_API_KEY="placeholder-openai-key"

FASTAPI_BACKEND_URL="http://127.0.0.1:8000"
AGENT_HUMAN_GATE_THRESHOLD="100000.00"

# Auth (Phase 3, Section 3) — signs/verifies the session JWT delivered via an
# HTTP-only cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="placeholder-generate-a-real-random-secret"

# Scheduler (Phase 3, Section 7.1) — daily digest, login-request expiry, Gmail
# sync. Leave "false" for local dev/tests; set "true" on the deployed backend (Render).
ENABLE_SCHEDULER="false"
